# Discogs API token — get one at https://www.discogs.com/settings/developers
DISCOGS_TOKEN=your_token_here

# MusicBrainz app identifier (User-Agent header) — use format: AppName/Version (contact@example.com)
MUSICBRAINZ_APP=MusicGraph/1.0 (your@email.com)

# Neo4j connection (override if running Neo4j outside Docker)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=musicgraph
